+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Build an `App` with a synthetic process list of `n` rows so navigation
+    /// clamping can be exercised without touching the global watcher.
+    fn app_with_rows(n: usize) -> App {
+        let mut app = App::new();
+        app.sorted_processes = (0..n)
+            .map(|i| CachedProcessInfo {
+                pid: i as u32,
+                name: format!("proc{i}"),
+                ..Default::default()
+            })
+            .collect();
+        app
+    }
+
+    #[test]
+    fn new_starts_on_processes_panel_sorted_by_memory_desc() {
+        let app = App::new();
+        assert_eq!(app.active_panel, ActivePanel::Processes);
+        assert_eq!(app.sort_col, SortColumn::Memory);
+        assert!(!app.sort_asc, "default sort must be descending");
+        assert_eq!(app.selected, 0);
+        assert_eq!(app.scroll_offset, 0);
+        assert!(!app.should_quit);
+        assert!(!app.chat_loading);
+        // The seed chat history is exactly one System message.
+        assert_eq!(app.chat_messages.len(), 1);
+        assert_eq!(app.chat_messages[0].role, ChatRole::System);
+    }
+
+    #[test]
+    fn next_sort_cycles_through_every_column_and_wraps() {
+        let mut app = App::new();
+        // Start = Memory. The cycle is Memory -> Name -> Net -> Energy -> Cpu -> Memory.
+        let expected = [
+            SortColumn::Name,
+            SortColumn::Net,
+            SortColumn::Energy,
+            SortColumn::Cpu,
+            SortColumn::Memory,
+        ];
+        for col in expected {
+            app.next_sort();
+            assert_eq!(app.sort_col, col);
+            // Every column switch resets the direction to descending.
+            assert!(!app.sort_asc);
+        }
+    }
+
+    #[test]
+    fn next_sort_resets_ascending_flag_to_descending() {
+        let mut app = App::new();
+        app.toggle_sort_dir();
+        assert!(app.sort_asc);
+        app.next_sort();
+        assert!(!app.sort_asc, "changing column must force descending");
+    }
+
+    #[test]
+    fn toggle_sort_dir_flips_between_asc_and_desc() {
+        let mut app = App::new();
+        assert!(!app.sort_asc);
+        app.toggle_sort_dir();
+        assert!(app.sort_asc);
+        app.toggle_sort_dir();
+        assert!(!app.sort_asc);
+    }
+
+    #[test]
+    fn select_up_saturates_at_zero() {
+        let mut app = app_with_rows(3);
+        app.selected = 0;
+        app.select_up();
+        assert_eq!(app.selected, 0, "must not underflow below the first row");
+        app.selected = 2;
+        app.select_up();
+        assert_eq!(app.selected, 1);
+    }
+
+    #[test]
+    fn select_down_clamps_at_last_row() {
+        let mut app = app_with_rows(3);
+        app.selected = 0;
+        app.select_down();
+        assert_eq!(app.selected, 1);
+        app.selected = 2; // already last
+        app.select_down();
+        assert_eq!(app.selected, 2, "must not move past the last row");
+    }
+
+    #[test]
+    fn select_down_is_noop_on_empty_list() {
+        let mut app = app_with_rows(0);
+        app.selected = 0;
+        app.select_down();
+        assert_eq!(app.selected, 0);
+    }
+
+    #[test]
+    fn select_page_up_saturates_without_underflow() {
+        let mut app = app_with_rows(50);
+        app.selected = 5;
+        app.select_page_up(20);
+        assert_eq!(app.selected, 0, "page up from row 5 lands on the first row");
+        app.selected = 30;
+        app.select_page_up(20);
+        assert_eq!(app.selected, 10);
+    }
+
+    #[test]
+    fn select_page_down_clamps_to_last_row() {
+        let mut app = app_with_rows(50);
+        app.selected = 0;
+        app.select_page_down(20);
+        assert_eq!(app.selected, 20);
+        app.selected = 45;
+        app.select_page_down(20);
+        assert_eq!(app.selected, 49, "page down must clamp to the final index");
+    }
+
+    #[test]
+    fn select_page_down_on_empty_list_stays_at_zero() {
+        let mut app = app_with_rows(0);
+        app.select_page_down(20);
+        assert_eq!(app.selected, 0, "no rows means index stays clamped at zero");
+    }
+}
